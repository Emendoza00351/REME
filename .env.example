# Variables para "docker compose up" (no para correr el backend/frontend a
# mano — para eso usá backend/.env y frontend/.env, ver sus .env.example).
#
# Copiar a ".env" en esta misma carpeta y completar antes de levantar los
# contenedores.

POSTGRES_PASSWORD=
JWT_SECRET=

# Opcionales — los valores por defecto ya sirven para correr todo en localhost.
# FRONTEND_URL=http://localhost:5173
# VITE_API_URL=http://localhost:3001
