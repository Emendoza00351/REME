# Copiar este archivo a ".env" (mismo folder) y completar PGPASSWORD y JWT_SECRET.
# ".env" nunca se sube a git (ver .gitignore).

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=reme

# Cadena larga y aleatoria (no la reutilices de otro proyecto). Se usa para
# firmar el token de sesión: sin ella el backend no arranca. En Railway hay
# que configurar esta misma variable en el servicio de backend.
JWT_SECRET=
